# Copy to config/deployment.env. This file is intentionally ignored by git.
WORKER_HOST=user@dgx-spark-worker.local
HEAD_IP=10.100.32.1
WORKER_IP=10.100.32.2
NIC=enp1s0f1np1
HCA=rocep1s0f1
MASTER_PORT=29627
API_PORT=8888

# The exact same path and immutable snapshot revision must exist on both nodes.
MODEL_REPO=/path/to/huggingface/hub/models--org--model
# deploy-official.sh supplies its validated revision. Set MODEL_REV explicitly
# for deploy-nvfp4.sh or when testing another immutable snapshot.
# MODEL_REV=replace-with-40-character-snapshot-revision
EXPECTED_MODEL_WEIGHT_FILES=48

# Prefer an immutable GHCR digest after the package Action completes.
IMAGE=ghcr.io/cyijun/deepseek-v4-flash-dgx-spark-tp2@sha256:f9724fb4a7feef44b83f32c10bc8826153eb2da000d1a0e5767f547c771cf444
PULL_IMAGE=1

# Unified-memory safety contract. Do not relax without a fresh capacity review.
CONTAINER_MEMORY_LIMIT=108g
CONTAINER_MEMORY_SWAP_LIMIT=108g
MIN_START_AVAILABLE_GIB=110
MIN_RUNTIME_AVAILABLE_GIB=10
MAX_RUNTIME_SWAP_GROWTH_MIB=512
KV_CACHE_MEMORY_BYTES=6442450944
MAX_MODEL_LEN=4096
MAX_NUM_SEQS=6

# Legacy b12x 0.15.3 standalone MXFP4 route used by the official preset.
# The tile override is deliberately bounded to the C6 routed-row envelope.
B12X_STANDALONE_MXFP4=1
B12X_W4A16_FORCE_TILE_CONFIG=128,64,128
B12X_W4A16_FORCE_BLOCKS_MAX_M=36

# Optional delayed Nsight Systems capture. Leave NSYS_OUTPUT_DIR empty for
# normal serving: the current SiLU/no-limit and deployment hot paths then have
# no profiler wrapper. Both hosts must expose the same absolute paths.
# NSYS_OUTPUT_DIR=/absolute/path/to/ignored/profiles/nsys-official-c6
# NSYS_HOST_ROOT=/opt/nvidia/nsight-systems/2025.3.2
# NSYS_SESSION_PREFIX=officialc6
